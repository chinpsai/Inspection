</style>
</head>
<body>
<div class="container">
  <h1>EI(R1) REPORT — LEW Inspection for Condominiums & Multi‑Tenanted Buildings</h1>
  <div class="btn-group no-print">
    <button class="btn-save" onclick="saveDraft()">💾 Save draft to local device</button>
    <button class="btn-clear" onclick="clearDraft()">🗑️Clear draft</button>
    <button class="btn-pdf" onclick="exportPdf()">📄 Generate EI(R1) PDF report</button>
  </div>

  <div id="reportEditor">
    <div class="section-title">PARTICULARS OF INSTALLATION</div>
    <div class="form-row">
      <label>Name of Installation</label>
      <input data-key="siteName"/>
    </div>
    <div class="form-row">
      <label>Address of Installation</label>
      <input data-key="siteAddr"/>
    </div>
    <div class="form-row">
      <label>Installation License No</label>
      <input data-key="licNo"/>
    </div>
    <div class="form-row">
      <label>Date of Inspection (DD/MM/YYYY)</label>
      <input data-key="inspectDate" placeholder="28/10/2026"/>
    </div>
    <div class="form-row">
      <label>LEW Name</label>
      <input data-key="lewName"/>
    </div>
    <div class="form-row">
      <label>LEW License No</label>
      <input data-key="lewLic"/>
    </div>

    <!-- 检查清单，完全复刻原报告所有检查条目 -->
    <div id="checklistWrap"></div>

    <div class="section-title">DECLARATION & WITNESS (Signature blank in PDF)</div>
    <div class="form-row">
      <textarea readonly style="background:#f8f8f8;">I have carried out inspection on [inspectDate], witnessed by the representative of the license and hereby I declare that the electrical installation is fit and safe for operation.

Name of LEW: _______________ License No: _______________ Signature: ________________________

THE INSPECTION WAS WITNESSED BY REPRESENTATIVE OF THE LICENSE
Name of Representative: ________________________
Designation: ________________________
Signature: ________________________
</textarea>
    </div>
  </div>

  <!-- PDF渲染目标区域 -->
  <div id="pdfRenderTarget" style="display:none;padding:16px;"></div>
</div>

<script>
// 完整EI‑R1检查清单，和你PDF一一对应
const checkListData = [
  {sec:"1 SITE CONDITIONS", items:[
    {ref:"1.1",desc:"Soil Subsidence"},
    {ref:"1.2",desc:"Drainage"},
    {ref:"1.3",desc:"Access"}
  ]},
  {sec:"2 ENVIRONMENT CONDITIONS", items:[
    {ref:"2.1",desc:"Switchroom locking facilities"},
    {ref:"2.2",desc:"Switchroom roof"},
    {ref:"2.3",desc:"Switchroom basement"},
    {ref:"2.4",desc:"Lighting"},
    {ref:"2.5",desc:"Ventilation"},
    {ref:"2.6",desc:"Not use as storage"}
  ]},
  {sec:"3 SWITCHROOM REQUIREMENTS", items:[
    {ref:"3.1",desc:"Rubber mat"},
    {ref:"3.2.1",desc:"Single‑line diagram"},
    {ref:"3.2.2",desc:"LEW's contact numbers"},
    {ref:"3.3",desc:"Instruction for treatment of electric shock"},
    {ref:"3.4",desc:"Installation license"},
    {ref:"3.5",desc:"Log Book (for HT Installation)"},
    {ref:"3.6",desc:"Danger signs and operating voltage of switchboard displayed"},
    {ref:"3.7",desc:"Fire extinguisher"}
  ]},
  {sec:"4 SWITCHBOARD REQUIREMENTS", items:[
    {ref:"4.1.1",desc:"Earth bar"},
    {ref:"4.1.2",desc:"Earth value"},
    {ref:"4.1.3",desc:"Test date"},
    {ref:"4.2.1",desc:"Earth electrode inspection chamber"},
    {ref:"4.2.2",desc:"Warning notice"},
    {ref:"4.3",desc:"Equipotential bonding"},
    {ref:"4.4",desc:"Earthing of metallic trunkings and conduits"},
    {ref:"4.5",desc:"Protection against direct contact"},
    {ref:"4.6.1",desc:"Incoming & outgoing indicator lights, voltmeter & ammeter"},
    {ref:"4.6.2",desc:"Neutral links"},
    {ref:"4.6.3",desc:"Busbar and circuit breakers sizes"},
    {ref:"4.6.4",desc:"Relay settings"},
    {ref:"4.6.5",desc:"Under‑voltage tripping device"},
    {ref:"4.6.6",desc:"DC supply and battery source (for HT Installation)"},
    {ref:"4.6.7",desc:"Supports for wiring & cables"},
    {ref:"4.6.8",desc:"Labelling of circuits"},
    {ref:"4.7.1",desc:"Temperature rise"},
    {ref:"4.7.2",desc:"Ionisation & corona discharge (for HT Installation)"},
    {ref:"4.7.3",desc:"Corrosion"}
  ]},
  {sec:"5 OPERATIONAL REQUIREMENTS", items:[
    {ref:"5.1",desc:"Incoming load"},
    {ref:"5.2",desc:"Load balancing"},
    {ref:"5.3",desc:"Overloading"},
    {ref:"5.4",desc:"Relay settings"},
    {ref:"5.5",desc:"Circuit connections at sub‑distribution boards"},
    {ref:"5.6.1",desc:"Suitability of MCBs & RCDs"},
    {ref:"5.6.2",desc:"Tripping currents of RCDs"}
  ]},
  {sec:"6 OTHER FEATURES", items:[
    {ref:"6.1",desc:"Outdoor fittings"},
    {ref:"6.2",desc:"30mA RCCBs in high risk areas"},
    {ref:"6.3",desc:"Standby Genset / ATS"},
    {ref:"6.4",desc:"Additional photo & remarks"},
    {ref:"6.5",desc:"Approved Load"}
  ]}
];

// 渲染检查项UI
function renderChecklist(){
  const wrap = document.getElementById("checklistWrap");
  wrap.innerHTML = "";
  checkListData.forEach(secObj=>{
    const secDiv = document.createElement("div");
    secDiv.className = "section-title";
    secDiv.innerText = secObj.sec;
    wrap.appendChild(secDiv);
    secObj.items.forEach(it=>{
      const card = document.createElement("div");
      card.className = "item-card";
      const itemKey = `chk_${it.ref.replace(".","_")}`;
      card.innerHTML = `
        <div class="item-head">${it.ref} — ${it.desc}</div>
        <div class="form-row">
          <label>Status</label>
          <select data-key="${itemKey}_status">
            <option value="✓">✓ Acceptable</option>
            <option value="✗">✗ Unacceptable</option>
            <option value="NA">NA Not‑Applicable</option>
          </select>
        </div>
        <div class="form-row">
          <label>Remarks</label>
          <textarea data-key="${itemKey}_rm" placeholder="Type remarks / rectification action here…"></textarea>
        </div>
        <div class="photo-area">
          <label>Attach Photo (for this inspection item)</label>
          <input type="file" accept="image/*" capture="camera" data-photokey="${itemKey}_pic"/>
          <div class="photo-preview" id="prev_${itemKey}"></div>
        </div>
      `;
      wrap.appendChild(card);
    })
  })
  bindPhotoInputs();
}

// 手机拍照预览
function bindPhotoInputs(){
  document.querySelectorAll('input[data-photokey]').forEach(input=>{
    input.onchange = function(e){
      const pk = this.dataset.photokey;
      const prevEl = document.getElementById("prev_"+pk);
      prevEl.innerHTML = "";
      if(!e.target.files[0]) return;
      const reader = new FileReader();
      reader.onload=ev=>{
        const img = new Image();
        img.src = ev.target.result;
        prevEl.appendChild(img);
      }
      reader.readAsDataURL(e.target.files[0]);
    }
  })
}

// 草稿保存到localStorage（手机浏览器本地）
function saveDraft(){
  const draft = {};
  document.querySelectorAll('[data-key]').forEach(el=>{
    draft[el.dataset.key] = el.value;
  })
  // 图片base64也存入草稿
  document.querySelectorAll('input[data-photokey]').forEach(inp=>{
    const pk = inp.dataset.photokey;
    const prevDiv = document.getElementById("prev_"+pk);
    if(prevDiv.firstChild && prevDiv.firstChild.src){
      draft[pk] = prevDiv.firstChild.src;
    }
  })
  localStorage.setItem("eiR1Draft", JSON.stringify(draft));
  alert("✅草稿已保存本机，关闭页面下次打开可以恢复");
}

// 加载草稿
function loadDraft(){
  const raw = localStorage.getItem("eiR1Draft");
  if(!raw) return;
  const draft = JSON.parse(raw);
  document.querySelectorAll('[data-key]').forEach(el=>{
    if(draft[el.dataset.key]!==undefined) el.value = draft[el.dataset.key];
  })
  //恢复图片预览
  Object.keys(draft).forEach(k=>{
    if(k.endsWith("_pic") && draft[k]){
      const prevDiv = document.getElementById("prev_"+k);
      if(!prevDiv) return;
      prevDiv.innerHTML="";
      const img=new Image(); img.src=draft[k];
      prevDiv.appendChild(img);
    }
  })
}

function clearDraft(){
  if(!confirm("确认清空全部草稿？不可恢复！")) return;
  localStorage.removeItem("eiR1Draft");
  location.reload();
}

// 导出PDF，复刻原版EI(R1)格式
function exportPdf(){
  alert("开始生成PDF，手机请稍候…");
  const target = document.getElementById("pdfRenderTarget");
  target.style.display="block";
  target.innerHTML = buildPdfHtml();
  const opt = {
    margin:12,filename:"EI_R1_INSPECTION_REPORT.pdf",
    image:{type:"jpeg",quality:0.8},
    html2canvas:{scale:2},jsPDF:{unit:"mm",format:"a4",orientation:"portrait"}
  };
  html2pdf().set(opt).from(target).save().then(()=>{
    target.style.display="none";
  })
}

// 构造PDF完整HTML（原版EMA报告版式）
function buildPdfHtml(){
  const draftStr = localStorage.getItem("eiR1Draft");
  const d = draftStr ? JSON.parse(draftStr) : {};
  const siteName = d["siteName"]||"";
  const siteAddr = d["siteAddr"]||"";
  const licNo = d["licNo"]||"";
  const inspDate = d["inspectDate"]||"";
  const lewName = d["lewName"]||"";
  const lewLic = d["lewLic"]||"";

  let html = `
  <h2>EI(R1) REPORT</h2>
  <h3>REPORT BY LICENSED ELECTRICAL WORKER (LEW) FOR CONDOMINIUMS AND MULTI‑TENANTED BUILDINGS</h3>
  <p style="font-size:12px;">This form has 7 sections and shall be filled up during site inspection in the presence of the consumer's representative. It may take at least 40 minutes to fill up the form, depending on the scale of the consumer's electrical installation. You will require your license number and the particulars of the electrical installation license to complete this report.</p>
  <p style="font-size:12px;"><b>Note:</b> The original copy of this report shall be submitted to the Energy Market Authority of Singapore. All boxes must be filled. Tick ( ✓), (✗) or (NA). Remarks column for rectification actions.</p>

  <h4>PARTICULARS OF INSTALLATION</h4>
  <table border="1" cellpadding="6" cellspacing="0" width="100%">
    <tr><td>Name of Installation</td><td>${siteName}</td></tr>
    <tr><td>Address of Installation</td><td>${siteAddr}</td></tr>
    <tr><td>Installation License No</td><td>${licNo}</td></tr>
    <tr><td>Date of Inspection</td><td>${inspDate}</td></tr>
  </table>
  <br/>
  `;

  //主检查表
  checkListData.forEach(secObj=>{
    html += `<h4>${secObj.sec}</h4>`;
    html += `<table border="1" cellpadding="5" cellspacing="0" width="100%">
    <thead><tr><th>Ref</th><th>Item Description</th><th>Status</th><th>Remarks</th></tr></thead><tbody>`;
    secObj.items.forEach(it=>{
      const kPre = `chk_${it.ref.replace(".","_")}`;
      const stat = d[`${kPre}_status`]||"";
      const rm = d[`${kPre}_rm`]||"";
      html += `<tr>
        <td>${it.ref}</td>
        <td>${it.desc}</td>
        <td>${stat}</td>
        <td style="max-width:320px;white-space:pre‑wrap;">${rm}</td>
      </tr>`;
    })
    html += `</tbody></table><br/>`;
  })

  //附录：照片，每条检查项附带图片+remarks
  html += `<h3>APPENDIX – SITE PHOTOS & REMARKS</h3>`;
  checkListData.forEach(secObj=>{
    secObj.items.forEach(it=>{
      const kPre = `chk_${it.ref.replace(".","_")}`;
      const picData = d[`${kPre}_pic`];
      const rm = d[`${kPre}_rm`]||"";
      if(picData){
        html += `<div><h4>${it.ref} — ${it.desc}</h4>`;
        html += `<img src="${picData}" style="max-width:100%;max-height:240px;"/>`;
        html += `<p><b>Remark:</b> ${rm}</p><hr/></div>`;
      }
    })
  })

  //LEW声明签字栏
  html += `
  <h4>DECLARATION BY LEW</h4>
  <p>I have carried out inspection on ${inspDate} (date of inspection), witnessed by the representative of the license and hereby I declare that the electrical installation is fit and safe for operation.</p>
  <p>Name of LEW: ${lewName} &nbsp;&nbsp; License No: ${lewLic}<br/>Signature: ________________________</p>
  <h4>THE INSPECTION WAS WITNESSED BY REPRESENTATIVE OF THE LICENSE</h4>
  <p>Name of Representative: ________________________<br/>Designation: ________________________<br/>Signature: ________________________</p>
  `;
  return html;
}

//页面打开自动恢复上次草稿
window.onload = function(){
  renderChecklist();
  loadDraft();
}
</script>
</body>
</html>
