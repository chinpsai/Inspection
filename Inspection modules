<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>EI(R1) LEW 检查报告生成器 (UCRT64)</title>
  <script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js"></script>
  <style>
    * { box-sizing: border-box; font-family: Arial, sans-serif; }
    body { margin: 0; padding: 12px; background: #f5f7fa; font-size: 14px; }
    .container { max-width: 780px; margin: 0 auto; background: #fff; padding: 16px; border-radius: 8px; }
    h1 { font-size: 18px; margin: 6px 0; }
    .section-title { background: #224078; color: #fff; padding: 8px; margin: 16px 0 8px; }
    .form-row { margin: 10px 0; }
    label { display: block; margin: 4px 0 2px; font-weight: 500; }
    input, textarea, select { width: 100%; padding: 8px; border: 1px solid #aaa; border-radius: 4px; font-size: 14px; }
    textarea { min-height: 70px; resize: vertical; }
    .item-card { border: 1px solid #ddd; padding: 10px; margin: 8px 0; border-radius: 6px; }
    .item-head { font-weight: bold; margin-bottom: 6px; }
    .photo-area { margin: 8px 0; }
    .photo-preview img { max-width: 100%; border: 1px solid #ccc; margin: 4px 0; }
    .btn-group { display: flex; gap: 8px; margin: 16px 0; flex-wrap: wrap; }
    button { padding: 10px 14px; border: none; border-radius: 5px; font-size: 14px; cursor: pointer; }
    .btn-save { background: #2b7bcc; color: white; }
    .btn-clear { background: #999; color: white; }
    .btn-pdf { background: #006633; color: white; }
    @media print {
      body { background: white; }
      .btn-group { display: none !important; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>
<div class="container">
  <h1>EI(R1) REPORT — LEW 检查报告 (公寓及多租户建筑)</h1>
  <div class="btn-group no-print">
    <button class="btn-save" onclick="saveDraft()">💾 保存草稿到本机</button>
    <button class="btn-clear" onclick="clearDraft()">🗑️ 清空草稿</button>
    <button class="btn-pdf" onclick="exportPdf()">📄 生成EI(R1) PDF报告</button>
  </div>

  <div id="reportEditor">
    <div class="section-title">安装详情 (PARTICULARS OF INSTALLATION)</div>
    <div class="form-row">
      <label>安装名称 (Name of Installation)</label>
      <input data-key="siteName"/>
    </div>
    <div class="form-row">
      <label>安装地址 (Address of Installation)</label>
      <input data-key="siteAddr"/>
    </div>
    <div class="form-row">
      <label>安装许可证编号 (Installation License No)</label>
      <input data-key="licNo"/>
    </div>
    <div class="form-row">
      <label>检查日期 (Date of Inspection) (DD/MM/YYYY)</label>
      <input data-key="inspectDate" placeholder="28/10/2026"/>
    </div>
    <div class="form-row">
      <label>LEW 姓名 (LEW Name)</label>
      <input data-key="lewName"/>
    </div>
    <div class="form-row">
      <label>LEW 许可证编号 (LEW License No)</label>
      <input data-key="lewLic"/>
    </div>

    <!-- 检查清单区域 -->
    <div id="checklistWrap"></div>

    <div class="section-title">声明与见证 (DECLARATION & WITNESS) — PDF中签名留空</div>
    <div class="form-row">
      <textarea readonly style="background:#f8f8f8;">本人已于 [检查日期] 在许可证代表见证下进行检查，并在此声明该电气装置适合且安全运行。

LEW姓名: _____ 许可证号: _____ 签名: ________

检查由许可证代表见证
代表姓名: ________
职位: ________
签名: ________
      </textarea>
    </div>
  </div>

  <!-- PDF渲染目标区域 (隐藏) -->
  <div id="pdfRenderTarget" style="display:none; padding:16px;"></div>
</div>

<script>
  // ==================== 完整EI-R1检查清单 ====================
  const checkListData = [
    { sec: "1 现场条件 (SITE CONDITIONS)", items: [
      { ref: "1.1", desc: "土壤沉降 (Soil Subsidence)" },
      { ref: "1.2", desc: "排水 (Drainage)" },
      { ref: "1.3", desc: "通道 (Access)" }
    ]},
    { sec: "2 环境条件 (ENVIRONMENT CONDITIONS)", items: [
      { ref: "2.1", desc: "开关室锁具设施 (Switchroom locking facilities)" },
      { ref: "2.2", desc: "开关室屋顶 (Switchroom roof)" },
      { ref: "2.3", desc: "开关室地下室 (Switchroom basement)" },
      { ref: "2.4", desc: "照明 (Lighting)" },
      { ref: "2.5", desc: "通风 (Ventilation)" },
      { ref: "2.6", desc: "未用作存储 (Not use as storage)" }
    ]},
    { sec: "3 开关室要求 (SWITCHROOM REQUIREMENTS)", items: [
      { ref: "3.1", desc: "橡胶垫 (Rubber mat)" },
      { ref: "3.2.1", desc: "单线图 (Single-line diagram)" },
      { ref: "3.2.2", desc: "LEW联系电话 (LEW's contact numbers)" },
      { ref: "3.3", desc: "电击处理说明 (Instruction for treatment of electric shock)" },
      { ref: "3.4", desc: "安装许可证 (Installation license)" },
      { ref: "3.5", desc: "日志簿 (Log Book) (适用于高压装置)" },
      { ref: "3.6", desc: "危险标志和运行电压显示 (Danger signs and operating voltage displayed)" },
      { ref: "3.7", desc: "灭火器 (Fire extinguisher)" }
    ]},
    { sec: "4 配电板要求 (SWITCHBOARD REQUIREMENTS)", items: [
      { ref: "4.1.1", desc: "接地棒 (Earth bar)" },
      { ref: "4.1.2", desc: "接地值 (Earth value)" },
      { ref: "4.1.3", desc: "测试日期 (Test date)" },
      { ref: "4.2.1", desc: "接地电极检查井 (Earth electrode inspection chamber)" },
      { ref: "4.2.2", desc: "警告标志 (Warning notice)" },
      { ref: "4.3", desc: "等电位联结 (Equipotential bonding)" },
      { ref: "4.4", desc: "金属线槽和导管的接地 (Earthing of metallic trunkings and conduits)" },
      { ref: "4.5", desc: "直接接触防护 (Protection against direct contact)" },
      { ref: "4.6.1", desc: "进出线指示灯、电压表和电流表 (Incoming & outgoing indicator lights, voltmeter & ammeter)" },
      { ref: "4.6.2", desc: "中性线连接 (Neutral links)" },
      { ref: "4.6.3", desc: "母线及断路器尺寸 (Busbar and circuit breakers sizes)" },
      { ref: "4.6.4", desc: "继电器设置 (Relay settings)" },
      { ref: "4.6.5", desc: "欠压脱扣装置 (Under-voltage tripping device)" },
      { ref: "4.6.6", desc: "直流电源和电池 (DC supply and battery source) (适用于高压装置)" },
      { ref: "4.6.7", desc: "线缆支撑 (Supports for wiring & cables)" },
      { ref: "4.6.8", desc: "电路标识 (Labelling of circuits)" },
      { ref: "4.7.1", desc: "温升 (Temperature rise)" },
      { ref: "4.7.2", desc: "电离和电晕放电 (Ionisation & corona discharge) (适用于高压装置)" },
      { ref: "4.7.3", desc: "腐蚀 (Corrosion)" }
    ]},
    { sec: "5 运行要求 (OPERATIONAL REQUIREMENTS)", items: [
      { ref: "5.1", desc: "进线负载 (Incoming load)" },
      { ref: "5.2", desc: "负载平衡 (Load balancing)" },
      { ref: "5.3", desc: "过载 (Overloading)" },
      { ref: "5.4", desc: "继电器设置 (Relay settings)" },
      { ref: "5.5", desc: "子配电板电路连接 (Circuit connections at sub-distribution boards)" },
      { ref: "5.6.1", desc: "MCB和RCD的适用性 (Suitability of MCBs & RCDs)" },
      { ref: "5.6.2", desc: "RCD跳闸电流 (Tripping currents of RCDs)" }
    ]},
    { sec: "6 其他特性 (OTHER FEATURES)", items: [
      { ref: "6.1", desc: "户外配件 (Outdoor fittings)" },
      { ref: "6.2", desc: "高风险区域30mA RCCB (30mA RCCBs in high risk areas)" },
      { ref: "6.3", desc: "备用发电机/ATS (Standby Genset / ATS)" },
      { ref: "6.4", desc: "额外照片与备注 (Additional photo & remarks)" },
      { ref: "6.5", desc: "批准负载 (Approved Load)" }
    ]}
  ];

  // 生成检查项UI
  function renderChecklist() {
    const wrap = document.getElementById("checklistWrap");
    wrap.innerHTML = "";
    checkListData.forEach(secObj => {
      const secDiv = document.createElement("div");
      secDiv.className = "section-title";
      secDiv.innerText = secObj.sec;
      wrap.appendChild(secDiv);
      secObj.items.forEach(it => {
        const card = document.createElement("div");
        card.className = "item-card";
        const itemKey = chk_${it.ref.replace(/\./g, "_")};
        card.innerHTML = `
          <div class="item-head">${it.ref} — ${it.desc}</div>
          <div class="form-row">
            <label>状态 (Status)</label>
            <select data-key="${itemKey}_status">
              <option value="✓">✓ 可接受</option>
              <option value="✗">✗ 不可接受</option>
              <option value="NA">NA 不适用</option>
            </select>
          </div>
          <div class="form-row">
            <label>备注 / 整改措施 (Remarks)</label>
            <textarea data-key="${itemKey}_rm" placeholder="在此输入备注 / 整改措施…"></textarea>
          </div>
          <div class="photo-area">
            <label>附上照片 (Attach Photo)</label>
            <input type="file" accept="image/*" capture="camera" data-photokey="${itemKey}_pic"/>
            <div class="photo-preview" id="prev_${itemKey}"></div>
          </div>
        `;
        wrap.appendChild(card);
      });
    });
    bindPhotoInputs();
  }

  // 手机拍照预览
  function bindPhotoInputs() {
    document.querySelectorAll('input[data-photokey]').forEach(input => {
      input.onchange = function(e) {
        const pk = this.dataset.photokey;
        const prevEl = document.getElementById("prev_" + pk);
        prevEl.innerHTML = "";
        if (!e.target.files[0]) return;
        const reader = new FileReader();
        reader.onload = ev => {
          const img = new Image();
          img.src = ev.target.result;
          prevEl.appendChild(img);
        };
        reader.readAsDataURL(e.target.files[0]);
      };
    });
  }

  // 保存草稿到localStorage
  function saveDraft() {
    const draft = {};
    document.querySelectorAll('[data-key]').forEach(el => {
      draft[el.dataset.key] = el.value;
    });
    // 图片base64也存入草稿
    document.querySelectorAll('input[data-photokey]').forEach(inp => {
      const pk = inp.dataset.photokey;
      const prevDiv = document.getElementById("prev_" + pk);
      if (prevDiv && prevDiv.firstChild && prevDiv.firstChild.src) {
        draft[pk] = prevDiv.firstChild.src;
      }
    });
    localStorage.setItem("eiR1Draft_ucrt64", JSON.stringify(draft));
    alert("✅ 草稿已保存到本机，关闭页面后下次打开可恢复。");
  }

  // 加载草稿
  function loadDraft() {
    const raw = localStorage.getItem("eiR1Draft_ucrt64");
    if (!raw) return;
    try {
      const draft = JSON.parse(raw);
      document.querySelectorAll('[data-key]').forEach(el => {
        if (draft[el.dataset.key] !== undefined) el.value = draft[el.dataset.key];
      });
      // 恢复图片预览
      Object.keys(draft).forEach(k => {
        if (k.endsWith("_pic") && draft[k]) {
          const prevDiv = document.getElementById("prev_" + k);
          if (!prevDiv) return;
          prevDiv.innerHTML = "";
          const img = new Image();
          img.src = draft[k];
          prevDiv.appendChild(img);
        }
      });
    } catch (e) {
      console.warn("草稿解析失败", e);
    }
  }

  function clearDraft() {
    if (!confirm("确认清空全部草稿？不可恢复！")) return;
    localStorage.removeItem("eiR1Draft_ucrt64");
    location.reload();
  }

  // 导出PDF
  function exportPdf() {
    alert("开始生成PDF，请稍候…");
    const target = document.getElementById("pdfRenderTarget");
    target.style.display = "block";
    target.innerHTML = buildPdfHtml();
    const opt = {
      margin: 12,
      filename: "EI_R1_INSPECTION_REPORT.pdf",
      image: { type: "jpeg", quality: 0.8 },
      html2canvas: { scale: 2 },
      jsPDF: { unit: "mm", format: "a4", orientation: "portrait" }
    };
    html2pdf().set(opt).from(target).save().then(() => {
      target.style.display = "none";
    }).catch(err => {
      console.error(err);
      alert("PDF生成失败，请检查控制台。");
      target.style.display = "none";
    });
  }

  // 构造PDF完整HTML（原版EMA报告版式）
  function buildPdfHtml() {
    const draftStr = localStorage.getItem("eiR1Draft_ucrt64");
    const d = draftStr ? JSON.parse(draftStr) : {};
    const siteName = d["siteName"] || "";
    const siteAddr = d["siteAddr"] || "";
    const licNo = d["licNo"] || "";
    const inspDate = d["inspectDate"] || "";
    const lewName = d["lewName"] || "";
    const lewLic = d["lewLic"] || "";

    let html = `
      <h2>EI(R1) 报告</h2>
      <h3>持牌电工 (LEW) 针对公寓及多租户建筑的检查报告</h3>
      <p style="font-size:12px;">本表格共7部分，应在消费者代表在场时于现场填写。根据电气装置规模，填写时间至少需要40分钟。您需要准备好许可证号码和电气装置许可证详情。</p>
      <p style="font-size:12px;"><b>注意：</b> 本报告原件应提交给新加坡能源市场管理局 (EMA)。所有方框必须填写。请勾选 (✓)、(✗) 或 (NA)。备注栏用于填写整改措施。</p>

      <h4>安装详情</h4>
      <table border="1" cellpadding="6" cellspacing="0" width="100%">
        <tr><td>安装名称</td><td>${siteName}</td></tr>
        <tr><td>安装地址</td><td>${siteAddr}</td></tr>
        <tr><td>安装许可证编号</td><td>${licNo}</td></tr>
        <tr><td>检查日期</td><td>${inspDate}</td></tr>
      </table>
      <br/>
    `;

    // 主检查表
    checkListData.forEach(secObj => {
      html += <h4>${secObj.sec}</h4>;
      html += `<table border="1" cellpadding="5" cellspacing="0" width="100%">
        <thead><tr><th>参考</th><th>项目描述</th><th>状态</th><th>备注</th></tr></thead><tbody>`;
      secObj.items.forEach(it => {
        const kPre = chk_${it.ref.replace(/\./g, "_")};
        const stat = d[${kPre}_status] || "";
        const rm = d[${kPre}_rm] || "";
        html += `<tr>
          <td>${it.ref}</td>
          <td>${it.desc}</td>
          <td>${stat}</td>
          <td style="max-width:320px;white-space:pre-wrap;">${rm}</td>
        </tr>`;
      });
      html += </tbody></table><br/>;
    });

    // 附录：照片，每条检查项附带图片+remarks
    html += <h3>附录 – 现场照片与备注</h3>;
    checkListData.forEach(secObj => {
      secObj.items.forEach(it => {
        const kPre = chk_${it.ref.replace(/\./g, "_")};
        const picData = d[${kPre}_pic];
        const rm = d[${kPre}_rm] || "";
        if (picData) {
          html += `<div style="margin-bottom:20px;">
            <h4>${it.ref} — ${it.desc}</h4>
            <img src="${picData}" style="max-width:100%;max-height:240px;border:1px solid #ccc;"/>
            <p><b>备注：</b> ${rm || "—"}</p>
            <hr/>
          </div>`;
        }
      });
    });

    // LEW声明签字栏
    html += `
      <h4>LEW 声明</h4>
      <p>本人已于 ${inspDate || "______"} 在许可证代表见证下进行检查，并在此声明该电气装置适合且安全运行。</p>
      <p>LEW 姓名： ${lewName || "_____"} &nbsp;&nbsp; 许可证号： ${lewLic || "_____"}<br/>签名： ________</p>
      <h4>检查由许可证代表见证</h4>
      <p>代表姓名： ________<br/>职位： ________<br/>签名： ________</p>
    `;
    return html;
  }

  // 页面初始化
  window.onload = function() {
    renderChecklist();
    loadDraft();
  };
</script>
</body>
</html>
